# syntax=docker/dockerfile:1
# Shared Rust images: mobipwn-api, mobipwn-jobs, mobipwn-search.
# Compose uses target + docker-compose.stack.yml build args (incl. HTTP_PROXY for git/cargo).
# Manual: docker build -f docker/Dockerfile.rust --target mobipwn-api .

# Transitive deps (yara-x, wasmtime from extractor libs) require rustc ≥ 1.91.
ARG RUST_IMAGE=rust:1.91-bookworm
FROM ${RUST_IMAGE} AS rust-base

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG BUGREPORT_EXTRACTOR_REPO=https://github.com/ismyphonepwned/bugreport-extractor-library.git
ARG SYSDIAGNOSE_EXTRACTOR_REPO=https://github.com/ismyphonepwned/sysdiagnose-extractor-library.git
ARG FAKEMUSTACHE_REPO=https://github.com/ismyphonepwned/fakeMustache.git
ARG MOBIPWN_EXTRACTOR_REF
ARG MOBIPWN_DISABLE_BUILD_PROXY
ARG MOBIPWN_CARGO_INSECURE_SSL=0

# Never ENV empty CARGO_HTTP_CHECK_REVOKE — cargo requires true|false if the var is set.
# Insecure SSL is driven only by MOBIPWN_CARGO_INSECURE_SSL (see docs/PROXY.md).
ENV HTTP_PROXY=$HTTP_PROXY \
    HTTPS_PROXY=$HTTPS_PROXY \
    NO_PROXY=$NO_PROXY \
    http_proxy=$HTTP_PROXY \
    https_proxy=$HTTPS_PROXY \
    no_proxy=$NO_PROXY \
    CARGO_NET_GIT_FETCH_WITH_CLI=true \
    MOBIPWN_CARGO_INSECURE_SSL=${MOBIPWN_CARGO_INSECURE_SSL}

COPY docker/setup-proxy-env.sh /usr/local/bin/setup-proxy-env.sh
RUN chmod +x /usr/local/bin/setup-proxy-env.sh \
 && { \
      echo '#!/bin/sh'; \
      echo '# Generated at image build — optional cargo/git SSL overrides'; \
      echo 'unset CARGO_HTTP_CHECK_REVOKE GIT_SSL_NO_VERIFY 2>/dev/null || true'; \
      if [ "${MOBIPWN_CARGO_INSECURE_SSL:-0}" = "1" ]; then \
        echo 'export CARGO_HTTP_CHECK_REVOKE=false'; \
        echo 'export GIT_SSL_NO_VERIFY=true'; \
      fi; \
    } > /etc/mobipwn-build-env.sh \
 && chmod +x /etc/mobipwn-build-env.sh \
 && if [ "${MOBIPWN_DISABLE_BUILD_PROXY:-0}" != "1" ]; then \
      HTTP_PROXY="${HTTP_PROXY:-}" HTTPS_PROXY="${HTTPS_PROXY:-}" NO_PROXY="${NO_PROXY:-}" \
        /usr/local/bin/setup-proxy-env.sh; \
    fi \
 && (apt-get update \
     && apt-get install -y --no-install-recommends git ca-certificates) \
 || { rm -f /etc/apt/apt.conf.d/99-mobipwn-proxy.conf; \
      env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy \
        apt-get update \
      && env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy \
        apt-get install -y --no-install-recommends git ca-certificates; } \
 && rm -rf /var/lib/apt/lists/*

COPY docker/clone-extractors.sh /tmp/clone-extractors.sh
COPY docker/deps /tmp/docker-deps
RUN chmod +x /tmp/clone-extractors.sh \
 && . /etc/mobipwn-build-env.sh \
 && if [ -f /tmp/docker-deps/bugreport-extractor-library/Cargo.toml ]; then \
      cp -a /tmp/docker-deps/bugreport-extractor-library /bugreport-extractor-library; \
    fi \
 && if [ -f /tmp/docker-deps/sysdiagnose-extractor-library/Cargo.toml ]; then \
      cp -a /tmp/docker-deps/sysdiagnose-extractor-library /sysdiagnose-extractor-library; \
    fi \
 && if [ -f /tmp/docker-deps/fakeMustache/Cargo.toml ]; then \
      cp -a /tmp/docker-deps/fakeMustache /fakeMustache; \
    fi \
 && BUGREPORT_EXTRACTOR_REPO="$BUGREPORT_EXTRACTOR_REPO" \
    SYSDIAGNOSE_EXTRACTOR_REPO="$SYSDIAGNOSE_EXTRACTOR_REPO" \
    FAKEMUSTACHE_REPO="$FAKEMUSTACHE_REPO" \
    MOBIPWN_EXTRACTOR_REF="$MOBIPWN_EXTRACTOR_REF" \
    HTTP_PROXY="$HTTP_PROXY" \
    HTTPS_PROXY="$HTTPS_PROXY" \
    /tmp/clone-extractors.sh

WORKDIR /app
COPY Cargo.lock ./
COPY docker/Cargo.docker.toml ./Cargo.toml
COPY mobipwn-core mobipwn-core
COPY mobipwn-search mobipwn-search
COPY mobipwn-ingest mobipwn-ingest
COPY mobipwn-api mobipwn-api
COPY mobipwn-jobs mobipwn-jobs
COPY migrations migrations

FROM rust-base AS rust-builder
# Build api+jobs together so heavy crates (wasmtime/cranelift) compile once.
# Cap parallelism to avoid OOM when Docker Desktop memory is limited.
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-2}
RUN env -u CARGO_HTTP_CHECK_REVOKE -u GIT_SSL_NO_VERIFY \
      sh -c '. /etc/mobipwn-build-env.sh && cargo build --release -p mobipwn-api -p mobipwn-jobs'

FROM rust-base AS rust-builder-search
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-2}
RUN env -u CARGO_HTTP_CHECK_REVOKE -u GIT_SSL_NO_VERIFY \
      sh -c '. /etc/mobipwn-build-env.sh && cargo build --release -p mobipwn-search'

FROM debian:bookworm-slim AS mobipwn-api
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG MOBIPWN_DISABLE_BUILD_PROXY
COPY docker/setup-proxy-env.sh /usr/local/bin/setup-proxy-env.sh
RUN chmod +x /usr/local/bin/setup-proxy-env.sh \
 && if [ "${MOBIPWN_DISABLE_BUILD_PROXY:-0}" != "1" ]; then \
      HTTP_PROXY="${HTTP_PROXY:-}" HTTPS_PROXY="${HTTPS_PROXY:-}" NO_PROXY="${NO_PROXY:-}" \
        /usr/local/bin/setup-proxy-env.sh; \
    fi \
 && (apt-get update \
     && apt-get install -y --no-install-recommends ca-certificates) \
 || { rm -f /etc/apt/apt.conf.d/99-mobipwn-proxy.conf; \
      env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy \
        apt-get update \
      && env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy \
        apt-get install -y --no-install-recommends ca-certificates; } \
 && rm -rf /var/lib/apt/lists/*
ENV HTTP_PROXY=${HTTP_PROXY:-} HTTPS_PROXY=${HTTPS_PROXY:-} NO_PROXY=${NO_PROXY:-} \
    http_proxy=${HTTP_PROXY:-} https_proxy=${HTTPS_PROXY:-} no_proxy=${NO_PROXY:-}
COPY --from=rust-builder /app/target/release/mobipwn-api /usr/local/bin/
EXPOSE 3000
CMD ["mobipwn-api"]

FROM debian:bookworm-slim AS mobipwn-jobs
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG MOBIPWN_DISABLE_BUILD_PROXY
COPY docker/setup-proxy-env.sh /usr/local/bin/setup-proxy-env.sh
RUN chmod +x /usr/local/bin/setup-proxy-env.sh \
 && if [ "${MOBIPWN_DISABLE_BUILD_PROXY:-0}" != "1" ]; then \
      HTTP_PROXY="${HTTP_PROXY:-}" HTTPS_PROXY="${HTTPS_PROXY:-}" NO_PROXY="${NO_PROXY:-}" \
        /usr/local/bin/setup-proxy-env.sh; \
    fi \
 && (apt-get update \
     && apt-get install -y --no-install-recommends ca-certificates) \
 || { rm -f /etc/apt/apt.conf.d/99-mobipwn-proxy.conf; \
      env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy \
        apt-get update \
      && env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy \
        apt-get install -y --no-install-recommends ca-certificates; } \
 && rm -rf /var/lib/apt/lists/*
ENV HTTP_PROXY=${HTTP_PROXY:-} HTTPS_PROXY=${HTTPS_PROXY:-} NO_PROXY=${NO_PROXY:-} \
    http_proxy=${HTTP_PROXY:-} https_proxy=${HTTPS_PROXY:-} no_proxy=${NO_PROXY:-}
COPY --from=rust-builder /app/target/release/mobipwn-jobs /usr/local/bin/
CMD ["mobipwn-jobs"]

FROM debian:bookworm-slim AS mobipwn-search
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG MOBIPWN_DISABLE_BUILD_PROXY
COPY docker/setup-proxy-env.sh /usr/local/bin/setup-proxy-env.sh
RUN chmod +x /usr/local/bin/setup-proxy-env.sh \
 && if [ "${MOBIPWN_DISABLE_BUILD_PROXY:-0}" != "1" ]; then \
      HTTP_PROXY="${HTTP_PROXY:-}" HTTPS_PROXY="${HTTPS_PROXY:-}" NO_PROXY="${NO_PROXY:-}" \
        /usr/local/bin/setup-proxy-env.sh; \
    fi \
 && (apt-get update \
     && apt-get install -y --no-install-recommends ca-certificates) \
 || { rm -f /etc/apt/apt.conf.d/99-mobipwn-proxy.conf; \
      env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy \
        apt-get update \
      && env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy \
        apt-get install -y --no-install-recommends ca-certificates; } \
 && rm -rf /var/lib/apt/lists/*
ENV HTTP_PROXY=${HTTP_PROXY:-} HTTPS_PROXY=${HTTPS_PROXY:-} NO_PROXY=${NO_PROXY:-} \
    http_proxy=${HTTP_PROXY:-} https_proxy=${HTTPS_PROXY:-} no_proxy=${NO_PROXY:-}
COPY --from=rust-builder-search /app/target/release/mobipwn-search /usr/local/bin/
EXPOSE 3002
CMD ["mobipwn-search"]
