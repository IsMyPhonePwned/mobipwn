# MobiPwn local development — copied to .env automatically on first ./dev.sh, ./compose.sh, or scripts/install.sh
# Edit .env for your machine (gitignored). See docs/PROXY.md for corporate proxy setup.

# --- Databases (match docker-compose.yml) ---
MOBIPWN_POSTGRES_URL=postgres://mobipwn:mobipwn@127.0.0.1:5432/mobipwn
MOBIPWN_CLICKHOUSE_URL=http://127.0.0.1:8123
MOBIPWN_CLICKHOUSE_USER=default
MOBIPWN_CLICKHOUSE_PASSWORD=mobipwn
MOBIPWN_CLICKHOUSE_DB=mobipwn
MOBIPWN_EVENTS_TTL_DAYS=90

# --- Services (./dev.sh sets API to web port + 1, e.g. 5173 → 5174) ---
MOBIPWN_WEB_PORT=5173
# Docker/Podman full stack (./compose.sh up) — nginx web + API in containers:
# MOBIPWN_STACK_WEB_PORT=8080
# MOBIPWN_API_PORT=3000
# MOBIPWN_POSTGRES_PORT=5432
# MOBIPWN_CLICKHOUSE_HTTP_PORT=8123
# MOBIPWN_CLICKHOUSE_NATIVE_PORT=9000
# Override only if not using ./dev.sh:
# MOBIPWN_API_BIND=0.0.0.0:5174
MOBIPWN_SEARCH_BIND=0.0.0.0:3002
MOBIPWN_SEARCH_URL=http://127.0.0.1:3002
MOBIPWN_JOBS_ENABLED=1

# --- Search admission ---
MOBIPWN_SEARCH_MAX_LIMIT=10000
MOBIPWN_SEARCH_DEFAULT_HOURS=24
MOBIPWN_SEARCH_REQUIRE_TIME_RANGE=1
MOBIPWN_SEARCH_MAX_QUERY_LEN=8192
MOBIPWN_SEARCH_MAX_JOINS=2

# --- Auth (dev defaults; change before any exposed deployment) ---
MOBIPWN_REQUIRE_AUTH=1
MOBIPWN_ADMIN_USER=admin
MOBIPWN_ADMIN_PASSWORD=admin
# API keys: create per user/client in Settings → API keys (not via .env).
# Optional: encrypt stored tokens for click-to-reveal in Settings (defaults to admin password in dev).
# MOBIPWN_API_KEY_ENCRYPTION_SECRET=

# --- Dev tooling ---
MOBIPWN_EXPOSE_DEV_LOGS=1
MOBIPWN_DEV_DIR=.dev
MOBIPWN_COLLECT_BLOB_DIR=.dev/collect-blobs
RUST_LOG=info,mobipwn=debug

# --- Optional LLM bootstrap (copied into DB on first start; then use Settings → LLM) ---
# MOBIPWN_LLM_API_URL=http://127.0.0.1:11434/v1
# MOBIPWN_LLM_MODEL=llama3.2
# MOBIPWN_LLM_API_URL=https://api.openai.com/v1
# MOBIPWN_LLM_API_KEY=sk-...
# MOBIPWN_LLM_MODEL=gpt-4o-mini

# --- mobipwn-mcp (Settings → MCP; auto-starts with API when enabled) ---
# MOBIPWN_MCP_BIN=/path/to/mobipwn-mcp
# MOBIPWN_MCP_AUTO_START=1
# MOBIPWN_API_URL=http://127.0.0.1:5174

# --- Corporate / outbound proxy (uncomment and set; see docs/PROXY.md) ---
# Used by ./dev.sh (npm/cargo), ./compose.sh image builds (git clone + cargo), and mobipwn-web/.npmrc sync.
# HTTP_PROXY=http://proxy.corp.example:8080
# HTTPS_PROXY=http://proxy.corp.example:8080
# NO_PROXY=localhost,127.0.0.1,postgres,clickhouse,mobipwn-api,mobipwn-jobs,mobipwn-web,.corp.example
# Setting HTTP_PROXY alone enables cargo proxy fixes (sparse index, git CLI). See docs/PROXY.md.

# --- Docker/Podman Rust build: extractor libraries (cloned in image if not on host) ---
# BUGREPORT_EXTRACTOR_REPO=https://github.com/ismyphonepwned/bugreport-extractor-library.git
# SYSDIAGNOSE_EXTRACTOR_REPO=https://github.com/ismyphonepwned/sysdiagnose-extractor-library.git
# MOBIPWN_EXTRACTOR_REF=main
# Set to 1 if HTTP_PROXY breaks image build but runtime proxy is still needed:
# MOBIPWN_DISABLE_BUILD_PROXY=1

# --- Pre-built images from a registry (see docs/DOCKER_DEPLOY.md) ---
# MOBIPWN_IMAGE_REGISTRY=ghcr.io/YOUR_GITHUB_USER/mobipwn
# MOBIPWN_IMAGE_TAG=1.0.0

# --- Cargo SSL behind corporate TLS interception (see docs/PROXY.md) ---
# Linux: copies /etc/ssl/certs/ca-certificates.crt (+ optional MOBIPWN_EXTRA_CA_PEM) into .dev/cargo-ca-bundle.pem
# MOBIPWN_CARGO_INSECURE_SSL=1
# MOBIPWN_EXTRA_CA_PEM=/path/to/corporate-root-ca.pem
# CARGO_HTTP_CAINFO=/path/to/corporate-ca.pem

# --- Rusty Magpie (mobi-android-collector) device binary for /collect ---
# Binary is gitignored; fetch from GitHub release or build with Android NDK.
# MOBIPWN_RUSTY_MAGPIE_MODE=auto   # auto | fetch | build | skip (Docker web defaults to fetch)
# RUSTY_MAGPIE_PREBUILT_URL=https://github.com/ismyphonepwned/mobipwn/releases/download/rusty-magpie-v0.1.0/rusty_magpie-aarch64-linux-android
# RUSTY_MAGPIE_PREBUILT_SHA256=
# MOBIPWN_SKIP_RUSTY_MAGPIE_BUILD=1
